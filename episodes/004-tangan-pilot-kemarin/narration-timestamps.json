{
  "version": 1,
  "voiceId": "voice_71a5a701-796e-421d-840e-0adc00b0816a",
  "durationSec": 153.5,
  "master": true,
  "chunks": [
    {
      "index": 0,
      "tag": null,
      "text": "Tangan di tuas itu bukan tanganmu. Isinya kamu sama copilot doang. Ada tangan kedua di tuas.",
      "start": 0,
      "end": 8.32,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 1,
      "tag": null,
      "text": "Beku selama kamu pegang. Lepas satu detik, dia langsung ambil alih. Pilot kemarin jatuh di rute ini.",
      "start": 8.74,
      "end": 16.16,
      "retries": 2,
      "status": "verified"
    },
    {
      "index": 2,
      "tag": null,
      "text": "Di petanya ada lingkaran tulisan tangan: CELAH. Tangan kananmu mulai kaku. Copilot nawarin gantian, kamu tolak.",
      "start": 16.16,
      "end": 25.84,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 3,
      "tag": null,
      "text": "Dia betulin arah pake kaki. Lampu panel kedip-kedip. Radio cuma statis.",
      "start": 26.46,
      "end": 32.44,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 4,
      "tag": null,
      "text": "Instingmu: lepas tuas, pegang radio. Sekali lepas, dia narik keras ke arah gunung. Baling-baling ekor nyangkut pinus mati.",
      "start": 32.98,
      "end": 43.44,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 5,
      "tag": null,
      "text": "Balik lagi. Lampu panel mati total. Instingmu: nyambar senter.",
      "start": 43.84,
      "end": 49.96,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 6,
      "tag": null,
      "text": "Begitu tanganmu naik, dia dorong tuas mentok kiri. Copilot nangkep. Lengannya terjepit, ambruk.",
      "start": 50.46,
      "end": 58.5,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 7,
      "tag": null,
      "text": "Jarum bensin makin turun. Instingmu: buka kran cadangan. Satu detik.",
      "start": 58.9,
      "end": 65.92,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 8,
      "tag": null,
      "text": "Satu detik cukup. Dia narik penuh. Dinding awan jadi dinding gunung.",
      "start": 66.22,
      "end": 72.5,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 9,
      "tag": null,
      "text": "Tamat. Setiap kali lepas, dia narik ke arah yang sama: lingkaran CELAH. Dia nggak mau bunuh kamu.",
      "start": 72.88,
      "end": 82.14,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 10,
      "tag": null,
      "text": "Dia mau nyampe. Jadiin arah itu arah pulang. Triknya: belok pake kaki.",
      "start": 82.58,
      "end": 88.42,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 11,
      "tag": null,
      "text": "Tangan tetep nempel di tuas. Pelan-pelan, derajat demi derajat, moncong heli mutar ke arah celah. Tanganmu mulai gemeter.",
      "start": 88.42,
      "end": 98.9,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 12,
      "tag": null,
      "text": "Copilot diam-diam perhatiin tangan kedua itu. Pas. Arah nariknya bener-bener nembus di tengah lingkaran.",
      "start": 99.34,
      "end": 107.52,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 13,
      "tag": null,
      "text": "Sekarang bagian paling gila: lepasin dua-duanya. Sengaja. Biarin dia nyetir.",
      "start": 107.9,
      "end": 114.54,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 14,
      "tag": null,
      "text": "Dan dia nyetir halus banget. Nembus celah presisi, kayak orang pulang ke rumah sendiri. Keluar dari awan, tangan itu pelan-pelan minggir dari tuas.",
      "start": 114.9,
      "end": 127.16,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 15,
      "tag": null,
      "text": "Terus lenyap. Kamu ambil alih lagi. Lampu landasan makin deket.",
      "start": 127.48,
      "end": 132.84,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 16,
      "tag": null,
      "text": "Copilot akhirnya napas lega. Roda nyentuh. Mesin pelan-pelan turun.",
      "start": 132.84,
      "end": 139.16,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 17,
      "tag": null,
      "text": "Di dalam, tuas balik netral sendiri. Peta pilot kemarin kebuka. Lingkaran CELAH-nya ada centang pensil.",
      "start": 139.76,
      "end": 147.82,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 18,
      "tag": null,
      "text": "Kayak dia bilang: selamat. Kamu berhasil sampai.",
      "start": 148.22,
      "end": 152,
      "retries": 2,
      "status": "failed"
    }
  ],
