{
  "duration": 4868,
  "rewinds": [1576, 2418, 2831],
  "shots": [
    {"panel": 1, "start": 0, "end": 78, "captions": [{"from": 0, "to": 78, "text": "Pintu keluar bioskop ini palsu."}]},
    {"panel": 2, "start": 78, "end": 329, "captions": [{"from": 78, "to": 152, "text": "Ranto lagi jaga proyektor"}, {"from": 152, "to": 227, "text": "ketika pintu balkon ketutup"}, {"from": 227, "to": 301, "text": "sendiri. Kuncinya tertinggal di"}, {"from": 301, "to": 320, "text": "luar."}]},
    {"panel": 3, "start": 329, "end": 524, "captions": [{"from": 329, "to": 403, "text": "Di bawah, barisan kursi"}, {"from": 403, "to": 478, "text": "terus bertambah, makin dekat"}, {"from": 478, "to": 515, "text": "ke balkon."}]},
    {"panel": 4, "start": 524, "end": 757, "captions": [{"from": 524, "to": 599, "text": "Layar tetap di tempat,"}, {"from": 599, "to": 673, "text": "tapi ujung kainnya terangkat"}, {"from": 673, "to": 748, "text": "oleh angin dari belakang."}]},
    {"panel": 5, "start": 757, "end": 1120, "captions": [{"from": 757, "to": 832, "text": "Jam tujuh anak Ranto"}, {"from": 832, "to": 906, "text": "tampil di panggung, dan"}, {"from": 906, "to": 981, "text": "dia janji nonton. Kalau"}, {"from": 981, "to": 1055, "text": "anaknya gugup, Ranto selalu"}, {"from": 1055, "to": 1111, "text": "bilang, ikutin cahayanya."}]},
    {"panel": 6, "start": 1120, "end": 1315, "captions": [{"from": 1120, "to": 1194, "text": "Ranto lari ke pintu"}, {"from": 1194, "to": 1269, "text": "merah bertuliskan keluar, lalu"}, {"from": 1269, "to": 1306, "text": "dorong palangnya."}]},
    {"panel": 7, "start": 1315, "end": 1576, "captions": [{"from": 1315, "to": 1390, "text": "Pintunya terbuka ke studio"}, {"from": 1390, "to": 1464, "text": "yang sama, tapi lantai"}, {"from": 1464, "to": 1539, "text": "di baliknya hilang. Ranto"}, {"from": 1539, "to": 1576, "text": "jatuh. Tamat."}]},
    {"panel": 8, "start": 1588, "end": 1971, "captions": [{"from": 1588, "to": 1663, "text": "Balik lagi. Ranto mau"}, {"from": 1663, "to": 1737, "text": "coba pintu darurat, tapi"}, {"from": 1737, "to": 1812, "text": "kali ini dia taruh"}, {"from": 1812, "to": 1886, "text": "senter di kursi dekat"}, {"from": 1886, "to": 1942, "text": "layar buat tanda."}]},
    {"panel": 9, "start": 1971, "end": 2418, "captions": [{"from": 1971, "to": 2045, "text": "Ranto buka pintu darurat."}, {"from": 2045, "to": 2120, "text": "Kursi yang ditandai senternya"}, {"from": 2120, "to": 2195, "text": "bergeser menjauh, sementara layar"}, {"from": 2195, "to": 2269, "text": "tetap di tempat. Ranto"}, {"from": 2269, "to": 2343, "text": "telanjur melangkah ke ruang"}, {"from": 2343, "to": 2418, "text": "kosong dan jatuh. Tamat."}]},
    {"panel": 10, "start": 2430, "end": 2607, "captions": [{"from": 2430, "to": 2505, "text": "Balik lagi. Ranto curiga"}, {"from": 2505, "to": 2579, "text": "sama proyektornya, lalu matiin"}, {"from": 2579, "to": 2598, "text": "lampunya."}]},
    {"panel": 11, "start": 2607, "end": 2831, "captions": [{"from": 2607, "to": 2682, "text": "Layar jadi gelap dan"}, {"from": 2682, "to": 2756, "text": "kursi berderak mundur, menghimpit"}, {"from": 2756, "to": 2831, "text": "Ranto ke balkon. Tamat."}]},
    {"panel": 12, "start": 2885, "end": 2987, "captions": [{"from": 2885, "to": 2959, "text": "Balik lagi, lampu proyektor"}, {"from": 2959, "to": 2978, "text": "nyala."}]},
    {"panel": 13, "start": 2987, "end": 3313, "captions": [{"from": 2987, "to": 3062, "text": "Kursi bisa bergeser, tapi"}, {"from": 3062, "to": 3136, "text": "layar tetap di tempat."}, {"from": 3136, "to": 3211, "text": "Ranto ingat angin yang"}, {"from": 3211, "to": 3285, "text": "berembus dari balik kain"}, {"from": 3285, "to": 3304, "text": "itu."}]},
    {"panel": 14, "start": 3313, "end": 3359, "captions": [{"from": 3313, "to": 3350, "text": "Ikutin cahayanya."}]},
    {"panel": 15, "start": 3359, "end": 3536, "captions": [{"from": 3359, "to": 3434, "text": "Ranto turun dan nyusurin"}, {"from": 3434, "to": 3508, "text": "lorong tengah, lurus menuju"}, {"from": 3508, "to": 3527, "text": "layar."}]},
    {"panel": 16, "start": 3536, "end": 3694, "captions": [{"from": 3536, "to": 3610, "text": "Di belakangnya, kursi berderak"}, {"from": 3610, "to": 3685, "text": "dan ruangan makin panjang."}]},
    {"panel": 17, "start": 3694, "end": 3852, "captions": [{"from": 3694, "to": 3768, "text": "Ranto naik ke panggung"}, {"from": 3768, "to": 3843, "text": "dan dorong kain layar."}]},
    {"panel": 18, "start": 3852, "end": 4066, "captions": [{"from": 3852, "to": 3927, "text": "Kainnya berat sampai lututnya"}, {"from": 3927, "to": 4001, "text": "hampir lemas. Dia coba"}, {"from": 4001, "to": 4057, "text": "lagi pakai bahu."}]},
    {"panel": 19, "start": 4066, "end": 4243, "captions": [{"from": 4066, "to": 4141, "text": "Kainnya robek, memperlihatkan pipa"}, {"from": 4141, "to": 4215, "text": "dan tembok bata di"}, {"from": 4215, "to": 4234, "text": "baliknya."}]},
    {"panel": 20, "start": 4243, "end": 4382, "captions": [{"from": 4243, "to": 4317, "text": "Cahaya pagi masuk dari"}, {"from": 4317, "to": 4373, "text": "bawah pintu besi."}]},
    {"panel": 21, "start": 4382, "end": 4633, "captions": [{"from": 4382, "to": 4456, "text": "Ranto belok kanan dan"}, {"from": 4456, "to": 4531, "text": "nunduk lewat bawah pintu."}, {"from": 4531, "to": 4605, "text": "Udara dingin langsung kena"}, {"from": 4605, "to": 4624, "text": "mukanya."}]},
    {"panel": 22, "start": 4633, "end": 4693, "captions": []},
    {"panel": 23, "start": 4693, "end": 4823, "captions": [{"from": 4693, "to": 4767, "text": "Ikutin cahayanya. Ranto masih"}, {"from": 4767, "to": 4823, "text": "sempat nonton anaknya."}]},
    {"panel": 24, "start": 4823, "end": 4868, "captions": []}
  ]
}
