{
  "duration": 4571,
  "rewinds": [1447, 2196, 2646],
  "shots": [
    {"panel": 1, "start": 0, "end": 78, "captions": [{"from": 0, "to": 78, "text": "Bioskop ini nggak punya pintu."}]},
    {"panel": 2, "start": 78, "end": 311, "captions": [{"from": 78, "to": 153, "text": "Ranto lagi jaga proyektor."}, {"from": 153, "to": 227, "text": "Pintu di balkon ketutup"}, {"from": 227, "to": 302, "text": "sendiri. Kuncinya di luar."}]},
    {"panel": 3, "start": 311, "end": 506, "captions": [{"from": 311, "to": 385, "text": "Di bawah, baris kursi"}, {"from": 385, "to": 460, "text": "nambah sendiri. Makin dekat"}, {"from": 460, "to": 497, "text": "ke balkon."}]},
    {"panel": 4, "start": 506, "end": 720, "captions": [{"from": 506, "to": 581, "text": "Layar tetap di tempat."}, {"from": 581, "to": 655, "text": "Ujung kainnya naik kena"}, {"from": 655, "to": 711, "text": "angin dari belakang."}]},
    {"panel": 5, "start": 720, "end": 990, "captions": [{"from": 720, "to": 795, "text": "Jam tujuh anaknya tampil."}, {"from": 795, "to": 869, "text": "Ranto janji nonton. Pesannya"}, {"from": 869, "to": 944, "text": "ke anaknya cuma satu."}, {"from": 944, "to": 981, "text": "Ikutin cahayanya."}]},
    {"panel": 6, "start": 990, "end": 1223, "captions": [{"from": 990, "to": 1065, "text": "Ranto lari ke pintu"}, {"from": 1065, "to": 1139, "text": "merah. Tulisan keluar masih"}, {"from": 1139, "to": 1214, "text": "nyala. Dia dorong palangnya."}]},
    {"panel": 7, "start": 1223, "end": 1447, "captions": [{"from": 1223, "to": 1298, "text": "Pintu kebuka. Di baliknya,"}, {"from": 1298, "to": 1372, "text": "studio yang sama. Lantainya"}, {"from": 1372, "to": 1447, "text": "hilang. Ranto jatuh. Tamat."}]},
    {"panel": 8, "start": 1459, "end": 1805, "captions": [{"from": 1459, "to": 1534, "text": "Balik lagi. Ranto mau"}, {"from": 1534, "to": 1608, "text": "coba pintu darurat. Dia"}, {"from": 1608, "to": 1683, "text": "taruh senter di kursi"}, {"from": 1683, "to": 1757, "text": "paling dekat layar, buat"}, {"from": 1757, "to": 1776, "text": "tanda."}]},
    {"panel": 9, "start": 1805, "end": 2196, "captions": [{"from": 1805, "to": 1879, "text": "Ranto buka pintu darurat."}, {"from": 1879, "to": 1954, "text": "Kursi yang ada senternya"}, {"from": 1954, "to": 2028, "text": "geser menjauh. Layarnya tetap"}, {"from": 2028, "to": 2103, "text": "di situ. Kakinya udah"}, {"from": 2103, "to": 2177, "text": "lewat ambang. Dia jatuh."}, {"from": 2177, "to": 2196, "text": "Tamat."}]},
    {"panel": 10, "start": 2208, "end": 2385, "captions": [{"from": 2208, "to": 2283, "text": "Balik lagi. Ranto curiga"}, {"from": 2283, "to": 2357, "text": "sama proyektornya. Dia matiin"}, {"from": 2357, "to": 2376, "text": "lampunya."}]},
    {"panel": 11, "start": 2385, "end": 2646, "captions": [{"from": 2385, "to": 2460, "text": "Layar gelap. Kursi berderak"}, {"from": 2460, "to": 2534, "text": "mundur. Semua baris dorong"}, {"from": 2534, "to": 2609, "text": "dia sampai kejepit di"}, {"from": 2609, "to": 2646, "text": "balkon. Tamat."}]},
    {"panel": 12, "start": 2700, "end": 2802, "captions": [{"from": 2700, "to": 2774, "text": "Balik lagi. Lampu proyektor"}, {"from": 2774, "to": 2793, "text": "nyala."}]},
    {"panel": 13, "start": 2802, "end": 3072, "captions": [{"from": 2802, "to": 2877, "text": "Kursinya bisa geser. Layar"}, {"from": 2877, "to": 2951, "text": "tetap di tempat. Dan"}, {"from": 2951, "to": 3026, "text": "tadi ada angin dari"}, {"from": 3026, "to": 3063, "text": "balik kainnya."}]},
    {"panel": 14, "start": 3072, "end": 3118, "captions": [{"from": 3072, "to": 3109, "text": "Ikutin cahayanya."}]},
    {"panel": 15, "start": 3118, "end": 3295, "captions": [{"from": 3118, "to": 3193, "text": "Ranto turun. Dia nyusurin"}, {"from": 3193, "to": 3267, "text": "lorong tengah, lurus ke"}, {"from": 3267, "to": 3286, "text": "layar."}]},
    {"panel": 16, "start": 3295, "end": 3434, "captions": [{"from": 3295, "to": 3369, "text": "Di belakangnya, kursi berderak."}, {"from": 3369, "to": 3425, "text": "Ruangan makin panjang."}]},
    {"panel": 17, "start": 3434, "end": 3592, "captions": [{"from": 3434, "to": 3508, "text": "Ranto naik ke panggung."}, {"from": 3508, "to": 3583, "text": "Dia dorong kain layar."}]},
    {"panel": 18, "start": 3592, "end": 3787, "captions": [{"from": 3592, "to": 3666, "text": "Kainnya berat. Lututnya hampir"}, {"from": 3666, "to": 3741, "text": "lemas. Dia dorong lagi"}, {"from": 3741, "to": 3778, "text": "pakai bahu."}]},
    {"panel": 19, "start": 3787, "end": 3964, "captions": [{"from": 3787, "to": 3862, "text": "Kainnya robek. Di baliknya"}, {"from": 3862, "to": 3936, "text": "ada pipa dan tembok"}, {"from": 3936, "to": 3955, "text": "bata."}]},
    {"panel": 20, "start": 3964, "end": 4103, "captions": [{"from": 3964, "to": 4038, "text": "Cahaya pagi masuk dari"}, {"from": 4038, "to": 4094, "text": "bawah pintu besi."}]},
    {"panel": 21, "start": 4103, "end": 4336, "captions": [{"from": 4103, "to": 4178, "text": "Ranto belok kanan. Dia"}, {"from": 4178, "to": 4252, "text": "nunduk lewat bawah pintu."}, {"from": 4252, "to": 4327, "text": "Udara dingin kena mukanya."}]},
    {"panel": 22, "start": 4336, "end": 4396, "captions": []},
    {"panel": 23, "start": 4396, "end": 4526, "captions": [{"from": 4396, "to": 4470, "text": "Ikutin cahayanya. Ranto masih"}, {"from": 4470, "to": 4526, "text": "sempat nonton anaknya."}]},
    {"panel": 24, "start": 4526, "end": 4571, "captions": []}
  ]
}
