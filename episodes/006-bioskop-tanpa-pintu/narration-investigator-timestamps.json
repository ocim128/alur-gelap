{
  "version": 1,
  "voiceId": "voice_71a5a701-796e-421d-840e-0adc00b0816a",
  "durationSec": 149.9,
  "master": true,
  "chunks": [
    {
      "index": 0,
      "tag": null,
      "text": "Bioskop ini nggak punya pintu. Bioskop tua. Kamu tukang proyektornya, di balkon belakang.",
      "start": 0,
      "end": 8.805,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 1,
      "tag": null,
      "text": "Pintu masuk studio ketutup sendiri. Kuncinya di luar. Di bawah, kursi nambah.",
      "start": 8.965,
      "end": 16.55,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 2,
      "tag": null,
      "text": "Tadi dua puluh, sekarang nyampe ujung. Layar putih besar di depan. Ujung bawahnya longgar, ketiup angin.",
      "start": 16.71,
      "end": 26.055,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 3,
      "tag": null,
      "text": "Pintu keluar merah di belakang. Pintu darurat di kiri. Tujuh pagi anakmu tampil.",
      "start": 26.215,
      "end": 33.46,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 4,
      "tag": null,
      "text": "Kamu selalu pesan: ikutin cahayanya. Kamu janji nonton. Kamu lari ke pintu keluar.",
      "start": 33.62,
      "end": 42.085,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 5,
      "tag": null,
      "text": "Dua daun merah kebuka. Di baliknya bukan lorong. Studio yang sama, dari tepi balkon.",
      "start": 42.245,
      "end": 50.43,
      "retries": 2,
      "status": "verified"
    },
    {
      "index": 6,
      "tag": null,
      "text": "Kamu melangkah ke lantai kosong. Tamat. Balik lagi.",
      "start": 50.59,
      "end": 54.775,
      "retries": 1,
      "status": "verified"
    },
    {
      "index": 7,
      "tag": null,
      "text": "Kamu taruh senter di kursi lorong. Sorotnya terang. Kamu lari ke pintu darurat kiri.",
      "start": 54.935,
      "end": 62.06,
      "retries": 2,
      "status": "verified"
    },
    {
      "index": 8,
      "tag": null,
      "text": "Pintunya kebuka. Kamu jatuh dari balkon kiri. Sambil jatuh, kamu lihat kursinya kosong.",
      "start": 62.22,
      "end": 70.745,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 9,
      "tag": null,
      "text": "Ujung kainnya masih terangkat. Tamat. Balik lagi.",
      "start": 70.905,
      "end": 75.95,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 10,
      "tag": null,
      "text": "Kamu matiin proyektor. Kalau cahaya biang keladinya, matiin aja. Layar gelap.",
      "start": 76.11,
      "end": 83.295,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 11,
      "tag": null,
      "text": "Ruangan ikut gelap. Baris kursi di depanmu berderak, mundur, menghimpitmu ke balkon. Tamat.",
      "start": 83.455,
      "end": 92.64,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 12,
      "tag": null,
      "text": "Balik lagi. Lampu proyektor nyala. Titik terang di kain nggak pernah geser.",
      "start": 92.8,
      "end": 100.065,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 13,
      "tag": null,
      "text": "Kain itu yang nggak ikut berubah. Ikutin cahayanya. Kamu turun.",
      "start": 100.225,
      "end": 105.05,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 14,
      "tag": null,
      "text": "Jalan lurus ke depan, nyusurin sorot lampu di lantai. Di belakangmu, kursi berderak. Ruangan makin panjang.",
      "start": 105.21,
      "end": 115.875,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 15,
      "tag": null,
      "text": "Kamu nggak noleh. Kamu naik ke panggung. Kamu dorong kain layar.",
      "start": 116.035,
      "end": 122.12,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 16,
      "tag": null,
      "text": "Kainnya berat. Kamu dorong lagi. Di balik layar: bata mentah, pipa, gang belakang.",
      "start": 122.28,
      "end": 131.145,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 17,
      "tag": null,
      "text": "Pintu besi gulung kebuka. Cahaya pagi masuk, dingin. Kamu jalan enam meter ke kanan.",
      "start": 131.305,
      "end": 138.75,
      "retries": 1,
      "status": "verified"
    },
    {
      "index": 18,
      "tag": null,
      "text": "Keluar. Di dinding luar gang, pintu keluar merah nggak pernah ada. Ikutin cahayanya.",
      "start": 138.91,
      "end": 146.975,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 19,
      "tag": null,
      "text": "Kali ini, kamu nggak jatuh.",
      "start": 147.135,
      "end": 149.9,
      "retries": 2,
      "status": "failed"
    }
  ],
