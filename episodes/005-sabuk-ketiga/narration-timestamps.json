{
  "version": 1,
  "voiceId": "voice_71a5a701-796e-421d-840e-0adc00b0816a",
  "durationSec": 155.985,
  "master": true,
  "chunks": [
    {
      "index": 0,
      "tag": null,
      "text": "Tiga sabuk terpasang. Penumpangnya cuma dua. Heli kecil nyangkut di atas laut awan, tengah malam.",
      "start": 0,
      "end": 7.68,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 1,
      "tag": null,
      "text": "Di bawah, awan nutupin gunung. Ujung satu puncak nembus dikit. Radio cuma desis.",
      "start": 8.04,
      "end": 15.16,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 2,
      "tag": null,
      "text": "Di belakang, sabuk ketiga kenceng ngelilit kursi kosong. Mepet pintu geser longgar, relnya bengkok. Copilot terikat rapat di kursi kiri.",
      "start": 15.6,
      "end": 26.56,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 3,
      "tag": null,
      "text": "Dia bilang, angin gunung suka bolong. Beneran, heli anjlok sekali. Kamu ganti pegangan tuas kemudi.",
      "start": 26.56,
      "end": 34.36,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 4,
      "tag": null,
      "text": "Kancing sabuk ketiga ikut geser. Telat satu ketukan. Suara menara radio masuk, tenang, jernih: turun, lewatin awan, izin darurat.",
      "start": 34.86,
      "end": 46.4,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 5,
      "tag": null,
      "text": "Instingmu: patuh. Heli miring masuk awan. Baling-baling ekor nyangkut punggung gunung.",
      "start": 46.94,
      "end": 53.7,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 6,
      "tag": null,
      "text": "Muter liar, ditelen kabut. Tamat. Balik lagi.",
      "start": 53.94,
      "end": 59,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 7,
      "tag": null,
      "text": "Copilot buka sabuknya, mau cek kursi belakang. Nyelip, hilang dari pandangan. Suara copilot manggil dari balik kursi.",
      "start": 59.5,
      "end": 67.7,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 8,
      "tag": null,
      "text": "Yang balik telat satu ketukan. Nggak mirip dia. Tamat.",
      "start": 68.2,
      "end": 72.46,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 9,
      "tag": null,
      "text": "Insting terakhir: buka sabukmu sendiri. Sabukmu kebuka. Satu ketukan kemudian, sabuk ketiga kebuka sendiri.",
      "start": 72.86,
      "end": 82.8,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 10,
      "tag": null,
      "text": "Udara bolong. Heli anjlok dalam. Kamu nggak diikat.",
      "start": 83.28,
      "end": 87.5,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 11,
      "tag": null,
      "text": "Panel kokpit hantam badanmu. Tamat. Balik lagi.",
      "start": 87.82,
      "end": 93.1,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 12,
      "tag": null,
      "text": "Nggak ada yang sempat buka sabuk. Perhatiin: dia niru kamu, telat satu ketukan. Nggak pernah duluan.",
      "start": 93.48,
      "end": 101.6,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 13,
      "tag": null,
      "text": "Itu celahnya. Kamu desek copilot: jangan buka sabuk, duduk diam. Kamu tarik pintu geser.",
      "start": 101.92,
      "end": 108.4,
      "retries": 1,
      "status": "verified"
    },
    {
      "index": 14,
      "tag": null,
      "text": "Relnya bengkok, cuma kebuka setengah. Pura-pura buka sabukmu: angkat lidah kancingnya sampai bunyi. Jangan ditekan.",
      "start": 108.86,
      "end": 117.44,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 15,
      "tag": null,
      "text": "Tahan napas. Satu ketukan. Sabuk ketiga kebuka sendiri.",
      "start": 117.44,
      "end": 123.88,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 16,
      "tag": null,
      "text": "Saat itu, tancep tuas kemudi sekeras-kerasnya. Heli miring tajam. Yang nggak diikat, terlempar keluar pintu geser.",
      "start": 124.32,
      "end": 133.5,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 17,
      "tag": null,
      "text": "Laut awan nutupin dia. Copilot bantu narik tuas. Heli datar lagi.",
      "start": 133.92,
      "end": 139.42,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 18,
      "tag": null,
      "text": "Langit pelan-pelan cerah. Sabuk ketiga kosong. Nggak ada yang niru.",
      "start": 139.74,
      "end": 145.56,
      "retries": 1,
      "status": "verified"
    },
    {
      "index": 19,
      "tag": null,
      "text": "Heli mendarat mulus. Pintu geser masih kebuka setengah. Cuma angin.",
      "start": 145.94,
      "end": 152.16,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 20,
      "tag": null,
      "text": "Kamu berhasil bertahan hidup.",
      "start": 152.54,
      "end": 154.84,
      "retries": 2,
      "status": "failed"
    }
  ],
